{
  "name": "@alexanderfedin/async-queue",
  "version": "2.0.0",
  "description": "TypeScript async producer-consumer queue with backpressure control, similar to Go channels or .NET Channel<T>",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:markers",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:esm": "tsc -p tsconfig.build.esm.json",
    "build:markers": "node scripts/write-dist-markers.js",
    "build:watch": "tsc -p tsconfig.build.cjs.json --watch",
    "clean": "rm -rf dist coverage .provenance-check",
    "prebuild": "npm run clean",
    "verify:provenance": "node scripts/verify-provenance.js",
    "verify:packaging": "node scripts/verify-packaging.js",
    "verify": "npm run build && npm run verify:provenance && npm run verify:packaging",
    "prepublishOnly": "npm run build && npm run verify:provenance && npm test",
    "test": "jest --testPathIgnorePatterns=stress",
    "test:stress": "jest --testNamePattern=\"stress\" --verbose --testTimeout=60000",
    "test:all": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:reports": "node scripts/generate-reports.js",
    "example": "ts-node examples/basic.ts",
    "example:backpressure": "ts-node examples/backpressure.ts",
    "example:multi": "ts-node examples/multiple-workers.ts",
    "example:iterator": "ts-node examples/async-iterator.ts",
    "benchmark": "ts-node benchmark/src/throughput.ts",
    "benchmark:compare": "ts-node benchmark/src/compare-implementations.ts",
    "benchmark:native": "ts-node benchmark/src/compare-native.ts",
    "benchmark:test": "jest benchmark/test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/o2alexanderfedin/async-queue-js.git"
  },
  "keywords": [
    "async",
    "queue",
    "backpressure",
    "producer-consumer",
    "channel",
    "concurrent",
    "push-pull",
    "flow-control",
    "promise",
    "async-await",
    "blocking-queue",
    "bounded-queue",
    "async-iterator",
    "async-iterable",
    "async-generator",
    "typescript",
    "circular-buffer",
    "high-performance"
  ],
  "author": "AI Hive® at O2.services (https://o2.services)",
  "contributors": [
    {
      "name": "AI Hive®",
      "email": "ai@o2.services",
      "url": "https://o2.services"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/o2alexanderfedin/async-queue-js/issues"
  },
  "homepage": "https://github.com/o2alexanderfedin/async-queue-js#readme",
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.38",
    "@types/benchmark": "^2.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "benchmark": "^2.1.4",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.3.0",
    "nyc": "^17.1.0",
    "ts-jest": "^29.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
